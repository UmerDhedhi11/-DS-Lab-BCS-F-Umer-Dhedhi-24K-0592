#include <iostream>
#include <cstring>
using namespace std;

int g[7][7];
int dista[7];
int vis[7];
int parent[7];

int minNode(){
    int mn = 1000000;
    int idx = -1;
    int i;
    for(i=1;i<=6;i++){
        if(!vis[i] && dista[i] < mn){
            mn = dista[i];
            idx = i;
        }
    }
    return idx;
}

void printPath(int v){
    int path[10];
    int cnt = 0;
    int i;
    while(v != -1){
        path[cnt++] = v;
        v = parent[v];
    }
    for(i=cnt-1;i>=0;i--){
        char c = 'A' + (path[i]-1);
        cout << c;
        if(i>0){
			cout << " -> ";
		}
    }
    cout << endl;
}

int main(){
    memset(g,0,sizeof(g));
	int i, v;
    g[1][2]=4; g[2][1]=4;
    g[2][3]=9; g[3][2]=9;
    g[1][4]=8; g[4][1]=8;
    g[3][4]=6; g[4][3]=6;
    g[3][5]=14; g[5][3]=14;
    g[4][6]=4; g[6][4]=4;
    g[5][6]=3; g[6][5]=3;
    for(i=1;i<=6;i++){
        dista[i] = 1000000;
        vis[i] = 0;
        parent[i] = -1;
    }
    int src = 2;
    dista[src] = 0;
    for(i=1;i<=6;i++){
        int u = minNode();
        if(u==-1) break;
        vis[u] = 1;
        for(v=1;v<=6;v++){
            if(g[u][v]>0 && !vis[v]){
                int nd = dista[u] + g[u][v];
                if(nd < dista[v]){
                    dista[v] = nd;
                    parent[v] = u;
                }
            }
        }
    }
    cout << "Shortest Distance = " << dista[5] << endl;
    printPath(5);
}
