#include <iostream>
#include <cstring>
using namespace std;

void buildLPS(char pat[], int m, int lps[]){
    int len = 0;
    lps[0] = 0;
    int i = 1;
    while(i<m){
        if(pat[i] == pat[len]){
            len++;
            lps[i] = len;
            i++;
        } 
		else{
            if(len != 0){
				len = lps[len-1];
            }
			else{
                lps[i] = 0;
                i++;
            }
        }
    }
}

void KMP(char text[], char pat[]){
    int n = strlen(text);
    int m = strlen(pat);
    int lps[200];
    buildLPS(pat,m,lps);
    int idx[1000];
    int k = 0;
    int i=0, j=0;
    int x;
    while(i<n){
        if(text[i] == pat[j]){
            i++;
            j++;
        }
        if(j == m){
            idx[k++] = i-j;
            j = lps[j-1];
        } 
		else if(i<n && text[i] != pat[j]){
            if(j!=0){
				j = lps[j-1];
            }
			else{
				i++;
			}
        }
    }
    cout << "[";
    for(x=0;x<k;x++){
        cout << idx[x];
        if(x<k-1){
			cout << ", ";
		}
    }
    cout << "]" << endl;
}

int main(){
    char text[200] = "ababababc";
    char pat[50] = "abab";
    KMP(text, pat);
    return 0;
}
