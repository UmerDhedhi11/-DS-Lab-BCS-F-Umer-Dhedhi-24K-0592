#include <iostream>
#include <cstring>
using namespace std;

void rabinKarp(char text[], char pat[]){
    int n = strlen(text);
    int m = strlen(pat);
    int p = 0, t = 0, h = 1;
    int d = 256;
    int q = 101;
    int idx[1000];
    int fp[1000];
    int kc = 0, fc = 0;
    int i;
    for(i=0;i<m-1;i++){
		h = (h * d) % q;
    }
	for(i=0;i<m;i++){
        p = (d*p + pat[i]) % q;
        t = (d*t + text[i]) % q;
    }
    int k = 0, f = 0;
    for(i=0;i<=n-m;i++){
        if(p == t){
            int j = 0;
            while(j<m && text[i+j] == pat[j]){
				j++;
            }
			if(j==m){
				idx[k++] = i;
			}
            else{
				fp[f++] = i;
			}
        }
        if(i<n-m){
            t = (d*(t - text[i]*h) + text[i+m]) % q;
            if(t<0){
				t += q;
			}
        }
    }
    cout << "[";
    for(i=0;i<k;i++){
        cout << idx[i];
        if(i<k-1){
			cout << ", ";
    	}
	}
    cout << "]" << endl;
    cout << "False Positive Hash Matches: [";
    for(i=0;i<f;i++){
        cout << fp[i];
        if(i<f-1){
			cout << ", ";
    	}
	}
    cout << "]" << endl;
}

int main(){
    char text[300] = "Data structures and algorithms are fun. Algorithms make tasks easier.";
    char pat[50] = "Algorithms";
    rabinKarp(text, pat);
}
