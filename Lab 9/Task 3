#include <iostream>
using namespace std;

class Node{
	public:
	    int key,height;
	    Node *left,*right;
	    Node(int k){
			key = k;
			height = 1;
			left = right = 0;
		}
};

class AVL{
	public:
	    Node* root = 0;
	    int h(Node* n){
			if(n){
				return n->height;
			}
			else{
				return 0;
			}
		}
	    int mx(int a,int b){
			if(a>b){
				return a;
			}
			else{
				return b;
			}
		}
	    int bf(Node* n){
			return h(n->left)-h(n->right);
		}
	    Node* rightRotate(Node* y){
	        Node* x = y->left;
	        Node* t = x->right;
	        x->right = y;
	        y->left = t;
	        y->height = mx(h(y->left),h(y->right))+1;
	        x->height = mx(h(x->left),h(x->right))+1;
	        return x;
	    }
	    Node* leftRotate(Node* x){
	        Node* y = x->right;
	        Node* t = y->left;
	        y->left = x;
	        x->right = t;
	        x->height = mx(h(x->left),h(x->right))+1;
	        y->height = mx(h(y->left),h(y->right))+1;
	        return y;
	    }
	    Node* insert(Node* n,int k){
	        if(!n){
				return new Node(k);
	        }
			if(k<n->key){
				n->left = insert(n->left,k);
	        }
			else{
				n->right = insert(n->right,k);
	        }
			n->height = mx(h(n->left),h(n->right))+1;
	        int b = bf(n);
	        if(b>1 && k<n->left->key){
				return rightRotate(n);
			}
	        if(b<-1 && k>n->right->key){
				return leftRotate(n);
			}
	        if(b>1 && k>n->left->key){
				n->left = leftRotate(n->left);
				return rightRotate(n);
			}
			if(b<-1 && k<n->right->key){
				n->right = rightRotate(n->right);
				return leftRotate(n);
			}
	        return n;
	    }
	    void showBF(Node* n){
	        if(!n){
				return;
	    	}
			cout << n->key << ":" << bf(n) << " ";
	        showBF(n->left);
	        showBF(n->right);
	    }
	    int height(){
			return h(root);
		}
	    void preorder(Node* n){
	        if(!n){
				return;
	        }
			cout << n->key << " ";
	        preorder(n->left);
	        preorder(n->right);
	    }
};

int main(){
    AVL t;
    int i;
    int arr[5]={10,5,15,3,7};
    for(i=0;i<5;i++){
		t.root = t.insert(t.root,arr[i]);
    }
	t.root = t.insert(t.root,12);
    t.showBF(t.root);
    cout << endl << t.height() << endl;
    t.preorder(t.root);
}

